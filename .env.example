# Copy to .env.local for development. Never commit real values.

# --- database ---------------------------------------------------------------
# Matches compose.yml.
DATABASE_URL=postgres://umbra:umbra@localhost:5432/umbra

# --- Janus gateway ----------------------------------------------------------
# Every third-party call goes through Janus, which holds the API secrets.
# There is no TMDB key and no Plex token in this file, by design (see JANUS.md).
JANUS_URL=https://janus.kisukesaama.com
JANUS_APPLICATION_ID=
JANUS_API_KEY=

# Slugs of the APIs Umbra is subscribed to.
JANUS_LIBRARY_SLUG=kisuflix
JANUS_METADATA_SLUG=tmdb-v3
# plex.tv, used by the sign-in flow. Must be registered by the operator first.
JANUS_PLEX_TV_SLUG=plex-tv

# --- site -------------------------------------------------------------------
# Public origin of this Umbra instance. Only used to build absolute icon and
# link-preview URLs, so a missing value costs a broken thumbnail, nothing more.
APP_URL=https://umbra.kisukesaama.com

# --- access -----------------------------------------------------------------
# Plex account id promoted to administrator on its first sign-in.
ADMIN_PLEX_ACCOUNT_ID=
# Approve every authenticated Plex account instead of waiting for a decision.
AUTO_APPROVE_MEMBERS=false
SESSION_TTL_DAYS=30
PLEX_PRODUCT=Umbra
PLEX_CLIENT_ID=umbra-hub
# Opens POST /api/auth/dev-login. Development only.
DEV_LOGIN=true

# --- storage ----------------------------------------------------------------
# Published volumes, as `Label:/path`, comma separated. Read only, and read from
# configuration only: no request can ever name a path.
STORAGE_PATHS=Media:/mnt/plex

# --- scheduled work ---------------------------------------------------------
# Shared by the worker and POST /api/cron/sync. At least 16 characters.
CRON_SECRET=
SYNC_INTERVAL_MINUTES=30
