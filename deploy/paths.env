# Static, non-secret deployment metadata. Sourced by the pipeline and passed to
# Compose. Committed to git. Must use LF line endings, see .gitattributes.
APP_SLUG=umbra
APP_SUBDOMAIN=umbra
DEPLOY_DIR=/home/kisuke/deploy-umbra
DATA_DIR=/home/kisuke/umbra
TRAEFIK_NETWORK=traefik
POSTGRES_IMAGE=postgres:18-alpine
# Media root, mounted read-only into the web container and used as the default
# STORAGE_PATHS the pipeline writes. Change both by changing this line.
MEDIA_ROOT=/mnt/plex
