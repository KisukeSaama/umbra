# Non-secret defaults, and documentation of the shape. The pipeline OVERWRITES
# this file at ${DEPLOY_DIR}/{dev,prod}/app.env with values built from CI/CD
# variables, so nothing here is read at runtime. Never put a credential in it.
POSTGRES_DB=umbra
POSTGRES_USER=umbra

# Janus holds every third-party credential; Umbra only carries its own key.
JANUS_URL=https://janus.kisukesaama.com
JANUS_LIBRARY_SLUG=kisuflix
JANUS_METADATA_SLUG=tmdb-v3
JANUS_ANIME_SLUG=myanimelist-v2
JANUS_PLEX_TV_SLUG=plex-tv
# plex.tv under a slug where Janus adds the owner token, read by the membership
# sweep only. The token itself never leaves the Janus vault.
JANUS_PLEX_OWNER_SLUG=plex-tv-owner

# Published storage volumes, as `Label:/path`. The path is read-only inside the
# container and comes from configuration, never from a request. The deployed
# value defaults to MEDIA_ROOT from paths.env, which is the path actually
# mounted; override it only alongside that mount.
STORAGE_PATHS=Media:/mnt/plex

SYNC_INTERVAL_MINUTES=30
